{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarshallBear1/juno-open-health-tools/schema/symptom-diary.schema.json",
  "title": "Juno Open Symptom Diary Record",
  "description": "A non-diagnostic, patient-controlled record of an observed symptom or health experience.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recorded_at", "description"],
  "properties": {
    "recorded_at": {"type": "string", "format": "date-time"},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "body_area": {"type": "string", "maxLength": 200},
    "intensity_0_to_10": {"type": "integer", "minimum": 0, "maximum": 10},
    "duration_minutes": {"type": "integer", "minimum": 0},
    "pattern": {"type": "string", "maxLength": 500},
    "context": {"type": "string", "maxLength": 1000},
    "possible_triggers": {"type": "array", "items": {"type": "string", "maxLength": 200}, "uniqueItems": true},
    "functional_impact": {"type": "string", "maxLength": 1000},
    "medication_note": {"type": "string", "maxLength": 1000},
    "free_text_note": {"type": "string", "maxLength": 4000},
    "tags": {"type": "array", "items": {"type": "string", "maxLength": 80}, "uniqueItems": true}
  }
}

