{
  "manifest_version": 3,
  "name": "Juno Appointment Prep – Symptom Notes",
  "short_name": "Juno Prep",
  "version": "1.0.0",
  "description": "Turn symptom observations into a concise, private appointment plan saved only on your device.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Open Juno Appointment Prep",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://github.com/MarshallBear1/juno-open-health-tools"
}
